DB_USER=root
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=miapp_db

SECRET_KEY=cambia_esto_por_una_clave_generada_con_secrets.token_hex(32)
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Orígenes permitidos por CORS, separados por coma. Vacío = solo same-origin
# (correcto en producción, ya que el frontend y la API se sirven juntos).
# Útil en desarrollo si abres el frontend con un dev server aparte, ej:
# ALLOWED_ORIGINS=http://localhost:5500,http://127.0.0.1:5500
ALLOWED_ORIGINS=

# Firebase Storage (alojamiento de imágenes de productos). Ver README.md
# para cómo generar el service account key y el nombre del bucket.
FIREBASE_STORAGE_BUCKET=tu-proyecto.appspot.com
# Opción A (desarrollo local): ruta a un archivo .json del service account.
GOOGLE_APPLICATION_CREDENTIALS=./firebase-service-account.json
# Opción B (plataformas sin subida de archivos, ej. Railway): contenido
# completo de ese mismo .json pegado como una sola línea. Si se define,
# tiene prioridad sobre GOOGLE_APPLICATION_CREDENTIALS.
# FIREBASE_SERVICE_ACCOUNT_JSON={"type": "service_account", ...}
